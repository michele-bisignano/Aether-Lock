{
  "version": 1,
  "author": "Aether-Lock Engineer",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s2-devkitm-1", "id": "esp", "top": -50, "left": -150, "attrs": {} },
    { "type": "wokwi-breadboard", "id": "bb1", "top": 80, "left": -150, "attrs": {} },
    
    { "type": "wokwi-potentiometer", "id": "hall-sensor", "top": 200, "left": 180, "attrs": { "label": "SS49E (Hall)" } },
    
    { "type": "wokwi-mosfet-n", "id": "mosfet", "top": 100, "left": 60, "attrs": { "label": "IRLZ44N" } },
    { "type": "wokwi-diode", "id": "flyback", "top": 140, "left": 100, "rotate": 90, "attrs": { "label": "1N4007" } },
    
    { "type": "wokwi-led", "id": "coil-led", "top": 50, "left": 120, "attrs": { "color": "blue", "label": "COIL EMULATION" } },
    { "type": "wokwi-resistor", "id": "r-coil", "top": 20, "left": 120, "rotate": 90, "attrs": { "value": "120", "label": "Coil Load" } },

    { "type": "wokwi-led", "id": "led-warn", "top": 260, "left": -80, "attrs": { "color": "red", "label": "OVERHEAT" } },

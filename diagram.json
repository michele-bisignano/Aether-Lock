    { "type": "wokwi-resistor", "id": "r-pulldown", "top": 150, "left": 10, "rotate": 90, "attrs": { "value": "10000", "label": "10k PullDown" } },
    { "type": "wokwi-resistor", "id": "r-series", "top": 210, "left": 80, "attrs": { "value": "1000", "label": "1k Filter" } },
    { "type": "wokwi-capacitor", "id": "c-filter", "top": 240, "left": 50, "attrs": { "value": "100n", "label": "100nF" } }
  ],
  "connections": [
    [ "esp:GND.1", "bb1:tn.1", "black", [] ],
    [ "esp:3V3", "bb1:tp.1", "red", [] ],
    
    [ "r-coil:1", "bb1:tp.25", "red", [ "v-30" ] ], 
    [ "r-coil:2", "coil-led:A", "blue", [] ],
    [ "coil-led:C", "mosfet:D", "blue", [] ], 
    [ "mosfet:S", "bb1:tn.20", "black", [] ], 
    
    [ "flyback:A", "mosfet:D", "green", [] ], 
    [ "flyback:C", "bb1:tp.25", "green", [ "v-20" ] ],

    [ "esp:25", "mosfet:G", "purple", [] ],
    [ "mosfet:G", "r-pulldown:1", "purple", [] ],
    [ "r-pulldown:2", "bb1:tn.18", "black", [] ],


    [ "hall-sensor:GND", "bb1:tn.50", "black", [] ],
    [ "hall-sensor:VCC", "bb1:tp.50", "red", [] ],
    
    [ "hall-sensor:SIG", "r-series:1", "green", [] ],
    [ "r-series:2", "esp:4", "green", [ "v0" ] ], 
    [ "r-series:2", "c-filter:1", "green", [] ],
    [ "c-filter:2", "bb1:tn.40", "black", [] ], 

    [ "esp:15", "r-warn:1", "orange", [] ],
    [ "r-warn:2", "led-warn:A", "red", [] ],
    [ "led-warn:C", "bb1:tn.10", "black", [] ]
